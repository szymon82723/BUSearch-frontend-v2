{
  "name": "busearch-frontend-v2",
  "private": true,
  "version": "0.1.0",
  "description": "Nowy frontend BUSearch (React, TypeScript, Vite, MapLibre GL)",
  "license": "GPL-3.0-only",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "check": "tsc --noEmit",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "test:map": "bun tests/map-actions.ts && bun tests/map-layout.ts",
    "test:vehicle": "bun tests/vehicle-route.ts",
    "test:vehicle:overlap": "bun tests/vehicle-overlap.ts",
    "test:line": "bun tests/line-route.ts",
    "test:timetable": "bun tests/timetable.ts",
    "test:search": "bun tests/search.ts",
    "test:planner": "bun tests/planner.ts",
    "test:planner:mobile": "bun tests/planner-mobile.ts"
  },
  "dependencies": {
    "lucide-react": "^1.16.0",
    "maplibre-gl": "^4.7.1",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.3.4",
    "puppeteer-core": "^25.12.0",
    "typescript": "^5.7.0",
    "vite": "^6.0.0"
  }
}
